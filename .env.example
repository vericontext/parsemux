# Parsemux Configuration
PARSEMUX_HOST=0.0.0.0
PARSEMUX_PORT=8000
PARSEMUX_UPLOAD_DIR=/tmp/parsemux_uploads
PARSEMUX_MAX_FILE_SIZE_MB=100

# CORS: comma-separated allowed origins
# Dev: "*" (default). Production: "https://parsemux.vercel.app"
# PARSEMUX_CORS_ORIGINS=https://parsemux.vercel.app,https://your-domain.com

# Server-side VLM key for local dev (skip typing in UI).
# Production: leave empty — users provide via UI (BYOK).
# Provider auto-detected from key prefix (sk-ant- → Anthropic, sk- → OpenAI, AI → Google).
# PARSEMUX_VLM_API_KEY=sk-...
