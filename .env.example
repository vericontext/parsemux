# Parsemux Configuration
# Mode: "local" (default, full OSS) or "demo" (cloud with restrictions)
# PARSEMUX_MODE=local

PARSEMUX_HOST=0.0.0.0
PARSEMUX_PORT=8000

# CORS: comma-separated allowed origins
# PARSEMUX_CORS_ORIGINS=https://parsemux.vercel.app

# Server-side VLM key for local dev (skip typing in UI).
# Provider auto-detected from key prefix (sk-ant- → Anthropic, sk- → OpenAI, AI → Google).
# PARSEMUX_VLM_API_KEY=sk-...

# --- Demo mode limits (only apply when MODE=demo) ---
# PARSEMUX_DEMO_MAX_FILE_SIZE_MB=10
# PARSEMUX_DEMO_RATE_LIMIT_PER_MIN=10
# PARSEMUX_DEMO_MAX_PAGES=50
# PARSEMUX_DEMO_DISABLE_MCP=true
